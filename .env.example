# Copy to .env to override docker-compose / local defaults. Never commit real credentials.

# --- Shared ---
REDIS_URL=redis://127.0.0.1:6379
# Key prefix: BullMQ keys live under <prefix>:queueforge:*, QueueForge metadata under <prefix>:meta:*
QUEUE_PREFIX=qf
LOG_LEVEL=info
# Human-readable logs for local development (requires the pino-pretty dev dependency)
LOG_PRETTY=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
REDIS_OPERATION_TIMEOUT_MS=3000
LIST_SCAN_WINDOW=200
KEEP_COMPLETED_COUNT=1000
KEEP_COMPLETED_AGE_SECONDS=86400
KEEP_FAILED_COUNT=5000
KEEP_FAILED_AGE_SECONDS=604800
# LOCAL DEVELOPMENT ONLY: exposes POST /api/v1/demo/workers/:id/crash. Keep false anywhere reachable.
DEMO_CONTROLS_ENABLED=false
EXPOSE_ERROR_DETAILS=false

# --- Worker ---
# WORKER_ID defaults to <hostname>-<pid>-<random suffix>
WORKER_CONCURRENCY=3
WORKER_LOCK_DURATION_MS=15000
WORKER_STALLED_INTERVAL_MS=5000
WORKER_MAX_STALLED_COUNT=2
WORKER_SHUTDOWN_TIMEOUT_MS=25000
# LOCAL DEVELOPMENT ONLY: lets the demo endpoint SIGKILL this worker.
WORKER_ALLOW_CRASH_COMMANDS=false

# --- docker compose only ---
WORKER_REPLICAS=2
DASHBOARD_PORT=8080
REDIS_PORT=6379
